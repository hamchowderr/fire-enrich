{
  "name": "fire-enrich-standalone",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "build:vercel": "node scripts/vercel-build.mjs",
    "start": "next start",
    "lint": "next lint",
    "lint:mastra": "mastra lint --dir lib/mastra --strict",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/db-migrate.mjs",
    "db:migrate:libsql": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/libsql-migrate.mjs",
    "db:sweep-runs": "node --env-file-if-exists=.env --env-file-if-exists=.env.local --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/sweep-runs.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "test:ai": "start-server-and-test aimock http-get://127.0.0.1:4010/health test",
    "aimock": "llmock -p 4010 -h 127.0.0.1 -f ./fixtures --validate-on-load --strict",
    "studio": "mastra dev --dir lib/mastra",
    "fallow:gate": "fallow dead-code --production --baseline fallow.baseline.json --fail-on-issues",
    "fallow:baseline": "fallow dead-code --production --save-baseline fallow.baseline.json",
    "check:lockfile": "node scripts/check-lockfile.mjs",
    "check": "npm run check:lockfile && npm run typecheck && npm run lint && npm run lint:mastra && npm run fallow:gate"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^4.0.88",
    "@ai-sdk/openai": "^4.0.72",
    "@libsql/client": "^0.18.0",
    "@mastra/agent-browser": "^0.5.3",
    "@mastra/browser-firecrawl": "^0.2.3",
    "@mastra/core": "^1.71.0",
    "@mastra/libsql": "^1.23.3",
    "@mastra/memory": "^1.32.1",
    "@radix-ui/react-dialog": "^1.1.13",
    "@radix-ui/react-label": "^2.1.6",
    "@radix-ui/react-select": "^2.2.4",
    "@radix-ui/react-slot": "^1.2.2",
    "@tailwindcss/typography": "^0.5.13",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@upstash/ratelimit": "^2.0.5",
    "@upstash/redis": "^1.34.9",
    "@vercel/oidc": "3.2.0",
    "agent-browser": "0.19.0",
    "class-variance-authority": "^0.7.1",
    "classnames": "^2.5.1",
    "clsx": "^2.1.1",
    "copy-to-clipboard": "^3.3.3",
    "firecrawl": "^4.41.0",
    "framer-motion": "^12.23.16",
    "geist": "^1.5.1",
    "lucide-react": "^0.511.0",
    "motion": "^12.23.16",
    "mysql2": "^3.24.4",
    "nanoid": "^5.1.5",
    "next": "15.3.9",
    "papaparse": "^5.4.1",
    "pixi.js": "^8.13.2",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-dropzone": "^14.3.5",
    "react-syntax-highlighter": "^15.6.1",
    "sonner": "^2.0.3",
    "tailwind-gradient-mask-image": "^1.2.0",
    "tailwind-merge": "^3.3.0",
    "zod": "^3.25.3"
  },
  "devDependencies": {
    "@copilotkit/aimock": "^1.42.1",
    "@eslint/eslintrc": "^3",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/supertest": "^7.2.1",
    "autoprefixer": "^10.4.16",
    "eslint": "^9",
    "eslint-config-next": "15.3.9",
    "fallow": "^3.27.0",
    "mastra": "^1.31.3",
    "postcss": "^8.4.32",
    "postcss-import": "^16.1.1",
    "postcss-nesting": "^13.0.2",
    "start-server-and-test": "^3.0.12",
    "supertest": "^7.2.2",
    "tailwindcss": "^3.4.0",
    "typescript": "^5",
    "undici": "^7.30.0",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "agent-browser": false,
    "edgedriver": false,
    "esbuild": false,
    "geckodriver": false,
    "sharp": false,
    "unrs-resolver": false
  }
}
