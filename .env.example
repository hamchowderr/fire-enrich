# Firecrawl API Key
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-your-api-key-here

# Vercel AI Gateway API Key
# Get yours at https://vercel.com/docs/ai-gateway
# One key for every model call: the legacy engine's OpenAI-compatible calls and the Mastra agents (no provider keys needed)
AI_GATEWAY_API_KEY=your-ai-gateway-key-here

# Turso database (optional)
# Leave both unset to use a local SQLite file at .mastra/fire-enrich.db.
# Set both to persist Mastra state in Turso, which serverless deployments need
# because their instances share no disk. Create one at https://turso.tech
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# AIMock (tests only)
# Set by tests/setup.ts and CI; never needed for a real run. With USE_AIMOCK=true
# every Mastra model call is served from ./fixtures by `npm run aimock`
# (an OpenAI-compatible mock server) instead of the gateway.
# USE_AIMOCK=true
# AIMOCK_URL=http://127.0.0.1:4010
# AIMOCK_MODEL=gpt-4o-mini

# Dolt database (optional; required only for /api/profiles)
# Dolt speaks the MySQL wire protocol; it adds a commit per write, so `dolt_log`
# shows who changed a profile and when.
#
# Left commented out on purpose. DOLT_HOST and DOLT_DATABASE are what switch the
# feature on, so copying this file as-is leaves the app booting normally and the
# profiles routes answering 503 — rather than pointing at a server that is not
# running and failing every request with ECONNREFUSED. Uncomment the four lines
# below once a Dolt server is up, then apply the schema with `npm run db:migrate`.
#
# Local dev: `dolt sql-server -H 127.0.0.1 -P 3306` from a Dolt data directory.
# It creates a root superuser with an empty password on first launch, and serves
# no TLS. Use 127.0.0.1, not localhost, which resolves to IPv6 on Windows.
# The database name differs per environment (e.g. fire_enrich locally,
# fire_enrich_prod hosted) so one set of credentials cannot write to the wrong one.
# DOLT_HOST=127.0.0.1
# DOLT_PORT=3306
# DOLT_USER=root
# DOLT_PASSWORD=
# DOLT_DATABASE=fire_enrich

# Hosted Dolt only: base64 of the server's CA certificate (`base64 -w0 ca.pem`).
# The hosted server requires TLS and presents a self-signed certificate, which
# Node rejects unless told to trust that CA. Base64 because a PEM is multi-line
# and an environment variable is not. Leave unset locally — there is no TLS.
# DOLT_TLS_CA_B64=your-base64-encoded-ca-pem-here

# Enrichment engine (optional)
# legacy | mastra — defaults to legacy.
# Selects which enrichment pipeline handles a request. The mastra engine is
# still being built; leave this on legacy.
ENRICH_ENGINE=legacy

# Enable unlimited mode (optional)
# When true, removes all limits on rows, columns, and file size
# Automatically enabled in development mode
FIRE_ENRICH_UNLIMITED=true

# Node environment (development/production)
NODE_ENV=development