# Firecrawl API Key
# Get yours at https://firecrawl.dev
FIRECRAWL_API_KEY=fc-your-api-key-here

# Vercel AI Gateway API Key
# Get yours at https://vercel.com/docs/ai-gateway
# One key for every model call the Mastra agents make (no provider keys needed)
# The key is for local development; on Vercel the deployment's OIDC token
# authenticates the gateway, so no key is set there.
AI_GATEWAY_API_KEY=your-ai-gateway-key-here

# Turso database (optional)
# Leave both unset to use a local SQLite file at .mastra/fire-enrich.db.
# Set both to persist Mastra state in Turso, which serverless deployments need
# because their instances share no disk. Create one at https://turso.tech
# TURSO_DATABASE_URL=libsql://your-database.turso.io
# TURSO_AUTH_TOKEN=your-turso-auth-token-here

# Upstash Redis rate limiting (optional)
# Leave unset and /api/scrape is not rate limited, in every environment.
# Set one complete pair to limit each IP to 50 scrape requests a day. Either
# naming works: UPSTASH_REDIS_REST_URL/TOKEN below, or KV_REST_API_URL and
# KV_REST_API_TOKEN, which Vercel's Upstash integration sets. A mixed
# pair (one of each) does not count. Create a database at https://upstash.com
# and copy its REST URL and token.
# UPSTASH_REDIS_REST_URL=https://your-database.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your-upstash-rest-token-here

# AIMock (tests only)
# Set by tests/setup.ts and CI; never needed for a real run. With USE_AIMOCK=true
# every Mastra model call is served from ./fixtures by `npm run aimock`
# (an OpenAI-compatible mock server) instead of the gateway.
# USE_AIMOCK=true
# AIMOCK_URL=http://127.0.0.1:4010
# AIMOCK_MODEL=gpt-4o-mini

# Dolt database (OPTIONAL; not needed to deploy or to enrich)
# Enables versioned run history: recorded runs, run diffs and the sweeper.
# Leave unset for a deployment with only the required services: enrichment
# works the same, runs are not recorded, and the run-history routes answer
# 501 "requires Dolt".
# Dolt speaks the MySQL wire protocol; it adds a commit per write, so `dolt_log`
# shows who changed a profile and when, and each enrichment run ends in one
# commit holding its enrichments and evidence.
#
# The variables below are commented out. DOLT_HOST and DOLT_DATABASE switch the
# feature on, so a copy of this file as-is boots the app without Dolt instead of
# pointing it at a server that is not running, which fails every request with
# ECONNREFUSED. Uncomment the variables once a Dolt server is up, then apply the
# schema with `npm run db:migrate`.
#
# Local dev: `dolt sql-server -H 127.0.0.1 -P 3306` from a Dolt data directory.
# It creates a root superuser with an empty password on first launch, and serves
# no TLS. Use 127.0.0.1, not localhost, which resolves to IPv6 on Windows.
# Use a separate database per environment, for example `fire_enrich` for local
# development and `fire_enrich_staging` for previews.
# DOLT_HOST=127.0.0.1
# DOLT_PORT=3306
# DOLT_USER=root
# DOLT_PASSWORD=
# DOLT_DATABASE=fire_enrich

# Author of the Dolt commit each enrichment run ends in (optional), as
# `Name <email>`. Unset or malformed: the default below. Shows in `dolt_log`.
# DOLT_COMMIT_AUTHOR=Fire Enrich <fire-enrich@localhost>

# Dolt server with TLS only: base64 of the server's CA certificate
# (`base64 -w0 ca.pem`). A server that requires TLS with a self-signed
# certificate, as docker-compose.dolt.yml sets up (docs/dolt-setup.md), is
# rejected by Node unless told to trust that CA. Base64 because a PEM is
# multi-line and an environment variable is not. Leave unset for a local server
# without TLS.
# DOLT_TLS_CA_B64=your-base64-encoded-ca-pem-here

# Default planner profile (optional)
# The profile id the planner uses when a request names none (the field
# generator UI never does). Unset: the newest profile is used, and with no
# profiles or no Dolt the planner plans with a generic profile.
# DEFAULT_PROFILE_ID=your-profile-id-here

# Evidence-support check (optional, off by default)
# With EVIDENCE_CHECK=1, each research finding's quote is checked against its
# value by an evaluation model (TypeSafe's Jev, typesafe-ai/jev on the AI
# Gateway, authenticated by AI_GATEWAY_API_KEY). A finding scoring below the
# threshold is left unknown. A classifier error or timeout keeps the finding.
# The AI SDK evaluation API is experimental.
# EVIDENCE_CHECK=1
# Probability of support a finding needs to be kept, 0 to 1. Default 0.5.
# EVIDENCE_CHECK_THRESHOLD=0.5

# Enable unlimited mode (optional)
# When true, removes all limits on rows, columns, and file size
# Automatically enabled in development mode
FIRE_ENRICH_UNLIMITED=true

# Node environment (development/production)
NODE_ENV=development