# Copy to deploy/dolt/dolt.env on the server (gitignored) and set both
# passwords. Both are empty on purpose. Generate each one with:
#
#   openssl rand -hex 24
#
# The image puts them into a quoted SQL string, so use letters and digits only
# (hex output is safe).
#
# If DOLT_PASSWORD is left empty, the container refuses to start
# ("DOLT_USER specified, but missing DOLT_PASSWORD"). An empty
# DOLT_ROOT_PASSWORD does not stop the start: root then has no password. Root
# can log in only from inside the container (the image's default
# DOLT_ROOT_HOST is localhost), but set a password for it anyway.

DOLT_ROOT_PASSWORD=

# The image runs CREATE DATABASE / CREATE USER IF NOT EXISTS for these on
# every start. The user gets ALL on this database and nothing server-wide.
# These three are the values the app uses.
DOLT_DATABASE=fire_enrich
DOLT_USER=fire_enrich
DOLT_PASSWORD=

# DOLT_USER may log in from any address. TLS and the password protect it.
DOLT_USER_HOST=%
