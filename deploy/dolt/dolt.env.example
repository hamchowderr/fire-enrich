# Copy to deploy/dolt/dolt.env on the server (gitignored) and replace both
# passwords. Generate each with `openssl rand -hex 24`: the image writes them
# into a quoted SQL string, so keep to letters and digits.

# root can log in only from inside the container (the image's default
# DOLT_ROOT_HOST is localhost). The password still protects it there.
DOLT_ROOT_PASSWORD=change-me-root

# Created on first start, while the data volume is empty. The user gets ALL on
# this database and nothing server-wide. These three are what the app uses.
DOLT_DATABASE=fire_enrich
DOLT_USER=fire_enrich
DOLT_PASSWORD=change-me-app

# DOLT_USER may log in from any address. TLS and the password protect it.
DOLT_USER_HOST=%
